 179   1          fx = 0;  fy = 0;
 180   1          net = 0; vrow = 0;
 181   1          aa  = 0;
 182   1      
 183   1          while(1)
 184   1          {
 185   2              // S1：一键启停，用取反定时器运行位来实现
 186   2              if(s1 == 0)
 187   2              {
 188   3                  delay(30);                          // 等按键稳定，去抖
 189   3                  if(s1 == 0) { TR0 = ~TR0; while(s1 == 0); }
 190   3              }
 191   2      
 192   2              // S2：切换左右，同时把模式拉回水平
 193   2              // fx 用异或翻转，比 if-else 少写几行
 194   2              if(s2 == 0)
 195   2              {
 196   3                  delay(30);
 197   3                  if(s2 == 0)
 198   3                  {
 199   4                      scroll_mode = 0;
 200   4                      fx ^= 1;
 201   4                      aa  = 0;
 202   4                      net = (fx == 0) ? 0 : zong;   // 向左从头，向右从尾
 203   4                      while(s2 == 0);
 204   4                  }
 205   3              }
 206   2      
 207   2              // S5：切换上下，同时把模式切到垂直
 208   2              // vrow 的起点也跟着方向走，不然切换时画面会闪
 209   2              if(s5 == 0)
