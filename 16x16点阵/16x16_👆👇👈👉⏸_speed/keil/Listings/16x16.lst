 211   3                  delay(30);
 212   3                  if(s5 == 0)
 213   3                  {
 214   4                      scroll_mode = 1;
 215   4                      fy ^= 1;
 216   4                      vrow = (fy == 0) ? 0 : 47;    // 向上从 0 开始，向下从 47 开始
 217   4                      while(s5 == 0);
 218   4                  }
 219   3              }
 220   2      
 221   2              // S3 加速 / S4 减速
 222   2              // speed 有上下限，别让它跑飞或者停死
 223   2              if(s3 == 0)
