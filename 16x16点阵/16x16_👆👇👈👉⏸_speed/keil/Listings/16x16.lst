 105          /*
 106              往 74HC595 送 16 位数据（两片级联）
 107              dat1 先送，dat2 后送，每次移位时钟给个上升沿
 108              全部移完再给锁存时钟，数据才会出现在输出引脚上
 109          
 110              注意：shcp 置 1 后要立刻清 0，不能只拉高不拉低，
 111              595 靠的是"上升沿"触发，高电平持续没用
 112          */
 113          
 114          void writedata(unsigned char dat1, unsigned char dat2)
 115          {
 116   1          unsigned char i;
C51 COMPILER V9.60.7.0   16X16                                                             04/16/2026 19:01:09 PAGE 3   

 117   1          for(i = 0; i < 8; i++) { dat1 <<= 1; ds = CY; shcp = 1; shcp = 0; }
 118   1          for(i = 0; i < 8; i++) { dat2 <<= 1; ds = CY; shcp = 1; shcp = 0; }
 119   1          stcp = 0; stcp = 1; stcp = 0;  // 锁存：低→高→低，产生上升沿
 120   1      }
 121          
 122          /*
 123              垂直滚动的核心，这里是整个程序最难理解的地方，多看几遍
 124          
 125              背景：
 126                  P2 选的是"列"，595 输出的是这一列里哪些"行"亮。
 127                  所以垂直滚动不能像水平那样挪偏移量，
 128                  得把每列本来的 16 位数据整体上移或下移若干位。
 129          
 130              模型：
 131                  想象一张高 48 行的虚拟纸条：
 132                      第  0~15 行：空白（字还没出现）
 133                      第 16~31 行：真正的"好"字
 134                      第 32~47 行：空白（字已经过去了）
 135                  vrow 是一扇 16 行高的"观察窗口"从纸条顶端往下数的位置。
 136                  vrow=0  → 窗口对着最上面的空白，屏幕全灭
 137                  vrow=16 → 窗口正好对着字，完整显示
 138                  vrow=32 → 窗口对着最下面的空白，屏幕又全灭
 139          
 140              计算：
 141                  窗口右移（vrow 变大）→ 字相对往上跑 → 视觉上字向上滚动
 142                  字在虚拟行 16~31，窗口顶端在 vrow：
 143                  ① vrow < 16：窗口上半在空白，下半开始看到字的顶部
 144                                字只露出底部 vrow 行 → 数据右移 (16-vrow) 位
 145                  ② vrow = 16：完整显示，直接用原始数据
 146                  ③ vrow > 16：字的顶部已经移出窗口，只剩底部
 147                                数据左移 (vrow-16) 位，高位自动补 0 就是空白
 148          */
 149          
 150          unsigned int compute_display(unsigned int char_val, unsigned char v)
 151          {
 152   1          if(v == 0 || v > 31) return 0;   // 窗口完全在空白区，直接返回全灭
 153   1      
 154   1          if(v <= 16)
 155   1              return char_val >> (16 - v); // 字从底部往上爬进来
 156   1          else
 157   1              return char_val << (v - 16); // 字从顶部往上飘出去
 158   1      }
 159          
 160          void main()
 161          {
 162   1          char i;
 163   1          int  aa;   // 水平扫描时跳过字模表用的小偏移，每列加 2，到 30 就归零
 164   1          unsigned int col_val, disp_val;
 165   1      
 166   1          // 定时器 0，16 位模式，12MHz 晶振，定时 10ms
 167   1          // 10ms 中断一次，攒够 speed 次再走一格，所以 speed 越小越快
 168   1          TMOD = 0x01;
 169   1          TH0  = (65536 - 10000) / 256;
 170   1          TL0  = (65536 - 10000) % 256;
 171   1          ET0  = 1;
 172   1          EA   = 1;
 173   1          TR0  = 1;
 174   1      
 175   1          zong = (unsigned int)(zi + 1) * 32;  // 1 个字 → 2 段 × 32 字节 = 64
 176   1      
 177   1          // 开机默认向左走，从头开始，垂直也从头
 178   1          scroll_mode = 0;
