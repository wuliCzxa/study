 235   2      
 236   2              // 主显示循环，P2 每次选一列，595 送这列的亮行数据
 237   2              // 每列点亮后要消隐（送全 0），不然切换到下一列时会有拖影
 238   2              if(scroll_mode == 0)
 239   2              {
 240   3                  // 水平模式：aa 从 0 跳到 30，配合 net 的偏移一起定位字模
C51 COMPILER V9.60.7.0   16X16                                                             04/16/2026 19:01:09 PAGE 5   

 241   3                  for(i = 0; i < 16; i++)
 242   3                  {
 243   4                      P2 = i;
 244   4                      if(fx == 0) writedata(tab [net + aa], tab [net + aa + 1]);
 245   4                      else        writedata(tab1[net + aa], tab1[net + aa + 1]);
 246   4                      delay(3);
 247   4                      writedata(0, 0);   // 消隐，防残影
 248   4                      aa += 2;
 249   4                      if(aa > 30) aa = 0;
 250   4                  }
 251   3              }
 252   2              else
 253   2              {
 254   3                  // 垂直模式：不靠偏移，靠位移
 255   3                  // 字符数据固定在 tab[32] 开始，按列取出来再交给 compute_display 算
 256   3                  for(i = 0; i < 16; i++)
 257   3                  {
 258   4                      // 第 i 列的原始点阵数据，两字节拼成 16 位
 259   4                      col_val  = (unsigned int)tab[32 + (unsigned char)(i * 2)]     << 8;
 260   4                      col_val |= (unsigned int)tab[32 + (unsigned char)(i * 2) + 1];
 261   4      
 262   4                      // 按当前 vrow 算出这列实际该送的数据
 263   4                      disp_val = compute_display(col_val, vrow);
 264   4      
 265   4                      P2 = i;
 266   4                      writedata((unsigned char)(disp_val >> 8), (unsigned char)(disp_val));
 267   4                      delay(3);
 268   4                      writedata(0, 0);
 269   4                  }
 270   3              }
 271   2          }
 272   1      }
 273          
 274          /*
 275              定时器 0 中断，每 10ms 进来一次
 276              不是每次都移动，要等 alt 攒够 speed 次才走一格，
 277              speed 越大等越久，看起来就越慢
 278          
 279              水平：net 每次动 2 字节（= 移动一列）
 280              垂直：vrow 每次动 1 行（= 移动一个像素行）
 281              两个方向的循环边界都是 zong 或 47，超出就绕回来
 282          */
 283          
 284          void timer0() interrupt 1
 285          {
 286   1          TH0 = (65536 - 10000) / 256;
 287   1          TL0 = (65536 - 10000) % 256;
 288   1      
 289   1          if(++alt < speed) return;   
 290   1          alt = 0;
 291   1      
 292   1          if(scroll_mode == 0)
 293   1          {
 294   2              if(fx == 0)
 295   2              {
 296   3                  net += 2;
 297   3                  if(net > zong) net = 0;
 298   3              }
 299   2              else
 300   2              {
 301   3                  if(net < 2) net = zong;
 302   3                  else        net -= 2;
C51 COMPILER V9.60.7.0   16X16                                                             04/16/2026 19:01:09 PAGE 6   

 303   3              }
 304   2          }
 305   1          else
 306   1          {
 307   2              if(fy == 0)
 308   2              {
 309   3                  vrow++;
 310   3                  if(vrow > 47) vrow = 0;    // 走完一圈回起点，无缝循环
 311   3              }
 312   2              else
 313   2              {
 314   3                  if(vrow == 0) vrow = 47;   // 同上，反向绕回
 315   3                  else          vrow--;
 316   3              }
 317   2          }
 318   1      }


