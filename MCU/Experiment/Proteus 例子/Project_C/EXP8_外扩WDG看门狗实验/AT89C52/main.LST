line level    source

   1          /*******************************************************************************  
   2          文件名称： main.c 
   3          作 者：    
   4          版 本：    V1.00
   5          说 明：    外扩WDG看门狗实验
   6          -------------------------------------------------------------------------------
   7          *功能描述:                               
   8          *当开关SW1置高时，程序清除硬件看门狗 LED流水灯正常运行                     
   9          *当开关SW1置低时，程序不清除看门狗，导致程序复位，LED流水灯无法正常运行                                   
             -        
  10          *注意：因AT89S52单片机为高电平复位，而MAX705复位为低电平，所以需加一个反向器
  11          *------------------------------------------------------------------------------
  12          *接线说明：P10-SW1 ，P11-WDT,/RESET经过反相后接单片机的RST,P00~P07-D1~D8
  13          *******************************************************************************/
  14          #include<reg52.h>
  15          #include <intrins.h>
  16          
  17          #define uchar unsigned char      //数据类型宏定义
  18          #define uint unsigned int
  19          /********引脚定义**************************************************************/
  20          #define LED   P0
  21          sbit SW1=P1^0;
  22          sbit WDT=P1^1;
  23          /********延时函数**************************************************************/
  24          void delayms(uchar ms)  
  25          // 延时子程序
  26          {                                               
  27   1              unsigned char i;
  28   1              while(ms--)
  29   1              {
  30   2                      for(i = 0; i < 120; i++);
  31   2              }
  32   1      }
  33          /*********主函数***************************************************************/
  34          void main(void)
  35          {
  36   1              LED = 0xfe;            //初始化LED
  37   1              WDT=1;
  38   1              _nop_();                   //初始化看门狗
  39   1              WDT=0;
  40   1              _nop_();
  41   1              WDT=1;
  42   1              _nop_();
  43   1              WDT=0;
  44   1              
  45   1              while(1)
  46   1              {
  47   2                      if(SW1)            //SW1=1时，喂狗
  48   2                      {
  49   3                              WDT=1;
  50   3                              _nop_();
  51   3                              WDT=0;
  52   3                              _nop_();
  53   3                              WDT=1;
  54   3                              _nop_();
C51 COMPILER V9.00   MAIN                                                                  10/27/2015 10:00:19 PAGE 2   

  55   3                              WDT=0;  
  56   3                      }
  57   2                      delayms(150);           //延时
  58   2                      delayms(150);                   
  59   2                      LED = _crol_(LED,1);//循环右移1位，点亮下一个LED
  60   2              }
  61   1      }


