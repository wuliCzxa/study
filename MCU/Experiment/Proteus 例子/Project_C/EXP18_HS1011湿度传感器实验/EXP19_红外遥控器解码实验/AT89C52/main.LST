  38          //========1MS延时====================================
  39          void delay(uint z)
  40          {
  41   1              uint x,y;
  42   1              for(x=z;x>0;x--)
  43   1                      for(y=113;y>0;y--);
  44   1      }
  45          //======LCD写命令=====
  46          void write_com(uchar com)
  47          {
  48   1              rs=0;
  49   1              lcde=0;
  50   1              P0=com;
  51   1              lcde=1;
  52   1              delay(1);//延时1MS跳过忙信号
  53   1              lcde=0;
  54   1              delay(1);
  55   1      }
