 118          unsigned int Ir_Get_Low()
 119          {
 120   1              TL1=0;
 121   1              TH1=0;
 122   1              TR1=1;
 123   1              while(!Ir_Pin && (TH1&0x80)==0);   //等待低电平到来              
 124   1              TR1=0;           
 125   1              return TH1*256+TL1;//提取低电平时间间隔时长
 126   1      }
 127          //======================================================
 128          //解码取回高电平========================================
 129          unsigned int Ir_Get_High()
 130          {
 131   1              TL1=0;
 132   1              TH1=0;
 133   1              TR1=1;
 134   1              while(Ir_Pin && (TH1&0x80)==0);//等待高电平到来
 135   1              TR1=0;
 136   1              return TH1*256+TL1;//提取高电平时间间隔时长
 137   1      }
 138          //======================================================
 139          //======================================================
 140          
 141          void main()
 142          {
 143   1              unsigned int temp;
 144   1              char i,j;
 145   1              init(); //初始化
 146   1      //=====用do做循环，等待遥控按键=========================
 147   1              do{
 148   2      restart:
 149   2                      while(Ir_Pin) ;//等待低电平
 150   2      
 151   2                      temp=Ir_Get_Low();//把低电平附给变量
 152   2                      if(temp<c(8500) || temp>c(9500)) continue;//引导脉冲低电平等待9000us
 153   2                      temp=Ir_Get_High();//把高电平附给变量
 154   2                      if(temp<c(4000) || temp>c(5000)) continue;//引导脉冲高电平等待4500us
 155   2                      //连续读出32个字节
 156   2                      for(i=0;i<4;i++) //4个字节
 157   2                      {
 158   3                              for(j=0;j<8;j++) //每个字节8位
 159   3                              {
 160   4                                      temp=Ir_Get_Low();
 161   4                                      if(temp<c(200) || temp>c(800)) goto restart;//等待560us跳过低电平
 162   4                                      temp=Ir_Get_High();
 163   4                                      if(temp<c(200) || temp>c(2000)) goto restart;//等待1000us跳过高电平
 164   4                                      Ir_Buf[i]>>=1;//把电平移进数组
 165   4                                      if(temp>c(1120)) Ir_Buf[i]|=0x80;//若为高电平再填1
 166   4                              }
 167   3                      }  
 168   2                      write_ir(Ir_Buf[2]);//调用显示  
 169   2              }       
 170   1              while(1);//循环
 171   1      }


