  56          //======LCD写数据=====================================
  57          void write_date(uchar date)
  58          {
  59   1              rs=1;
  60   1              lcde=0;
  61   1              P0=date;
  62   1              lcde=1;
  63   1              delay(1);
  64   1              lcde=0;
  65   1              delay(1);
  66   1      }
  67          //=====初始化函数=====================================
  68          void init()
  69          {       
  70   1              uchar num;
  71   1              rw=0;           //允许LCD写
  72   1              lcde=0;
  73   1              write_com(0x38);//显示模式设置                                                    
  74   1              write_com(0x0c);//显示开及光标设置
  75   1              write_com(0x06);//显示光标移动设置
  76   1              write_com(0x01);//清屏
  77   1              write_com(0x80);//显示首地址
  78   1              for(num=0;num<15;num++)//显示第一行
  79   1              {
  80   2                      write_date(table[num]);
  81   2                      delay(1);
  82   2              }
  83   1              write_com(0x80+0x40);//显示第二行
  84   1              for(num=0;num<16;num++)
  85   1              {
  86   2                      write_date(table1[num]);
  87   2                      delay(1);
  88   2              }
  89   1              TMOD=0x10;              //设置定时器0、1工作模式为1
  90   1      }
  91          //=====显示解码========================================
  92          void write_ir(uchar date)
  93          {
  94   1              uchar tmp, num,ff;        
  95   1      
  96   1              if(ff==0)
  97   1              {
  98   2                      ff++;
  99   2                      write_com(0x01);
 100   2                      write_com(0x80);
 101   2                      for(num=0;num<12;num++)
 102   2                      {
 103   3                              write_date(table2[num]);
 104   3                              delay(1);
 105   3                      }               
 106   2              }
 107   1              
 108   1              write_com(0xC0+6);//定位在第二行第六位
 109   1              tmp = date>>4;                  // 高四位        
 110   1              write_date(tmp > 9 ? 'A'+tmp-10 : '0'+tmp);
 111   1              write_com(0xC0+7);//定位第二行第七位       
 112   1              tmp = date&0x0F;                        // 低四位
 113   1              write_date(tmp > 9 ? 'A'+tmp-10 : '0'+tmp);      
 114   1      
 115   1      }
