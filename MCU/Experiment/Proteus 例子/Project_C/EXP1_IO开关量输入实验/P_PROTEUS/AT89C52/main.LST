   7          -------------------------------------------------------------------------   
   8          * 功能描述: 按键扫描程序
   9          * 上电时, 点亮P00口LED ，按下K1时, LED向右移一位，按下K2时, LED向左移一位 
  10          -------------------------------------------------------------------------
  11          * 接线说明：P10-K1，P11-K2，P00~P07——D1~D8
  12          *                                                           
  13          *************************************************************************/
  14          #include <reg52.h>
  15          #include <intrins.h>
  16          
  17          #define uchar unsigned char      //数据类型宏定义
  18          #define uint unsigned int
  19          
  20          /**********单片机IO口引脚定义********************************************/
  21          #define LED   P0
  22          sbit    K1 = P1^0;
  23          sbit    K2 = P1^1;
  24          /**********函数定义******************************************************/
  25          uchar scan_key();
  26          void proc_key(uchar key_v);
  27          void delayms(uchar ms);
  28          /**********主函数********************************************************/
  29          void main(void)
  30          {                                                                                                                                                                                 
  31   1              uchar key_s,key_v;
  32   1              key_v = 0x03;                //初始化IO口
  33   1              LED = 0xfe;
  34   1              while(1)
  35   1              {
  36   2                 delayms(10);
  37   2                      key_s = scan_key();
  38   2                      if(key_s != key_v)       //判断按键是否按下
  39   2                      {
  40   3                              delayms(10);     //延时消抖
  41   3                              key_s = scan_key();
  42   3                              if(key_s != key_v)
  43   3                              {       
  44   4                                      key_v = key_s;
  45   4                                      proc_key(key_v);                                        
  46   4                              }
  47   3                      }
  48   2              }       
  49   1      }
  50          /**********键盘扫描函数**************************************************/
  51          uchar scan_key()
  52          {
  53   1              uchar key_s;
  54   1              key_s = 0x00;
  55   1              key_s |= K2;
C51 COMPILER V8.18   MAIN                                                                  03/04/2018 11:07:54 PAGE 2   

  56   1              key_s <<= 1;
  57   1              key_s |= K1;
  58   1              return key_s;                     //返回按键号
  59   1      }
  60          /**********键盘处理函数**************************************************/
  61          void proc_key(uchar key_v)
  62          {
  63   1              if((key_v & 0x01) == 0)
  64   1              {
  65   2                      LED = _cror_(LED,1);  //循环右移一位
  66   2              }
  67   1              else if((key_v & 0x02) == 0)
  68   1              {
  69   2                      LED = _crol_(LED, 1); //循环左移一位
  70   2              }
  71   1      }
  72          /***********延时函数*****************************************************/
  73          void delayms(uchar ms)  
  74          // 延时子程序
  75          {                                               
  76   1              uchar i;
  77   1              while(ms--)
  78   1              {
  79   2                      for(i = 0; i < 120; i++);
  80   2              }
  81   1      }


