  16          #include <reg52.h>
  17          #include <intrins.h>
  18          
  19          unsigned char data dis_digit;
  20          unsigned char code dis_code[11]={0xc0,0xf9,0xa4,0xb0,   // 0, 1, 2, 3
  21                                                                           0x99,0x92,0x82,0xf8,0x80,0x90, 0xff};// 4, 5, 6, 7, 8, 9, off 
  22          unsigned char data dis_buf[8];
  23          unsigned char data dis_index;
  24          
  25          void main()
  26          {
  27   1              P0 = 0xff;        //端口初始化
  28   1              P2 = 0x00;
  29   1              TMOD = 0x01;      //定时器0初始化    
  30   1              TH0 = 0xFC;
  31   1              TL0 = 0x17;
  32   1              IE = 0x82;        //开中断，启动定时0
  33   1      
  34   1              dis_buf[0] = dis_code[0x1];
  35   1              dis_buf[1] = dis_code[0x2];
  36   1              dis_buf[2] = dis_code[0x3];
  37   1              dis_buf[3] = dis_code[0x4];
  38   1              dis_buf[4] = dis_code[0x5];
  39   1              dis_buf[5] = dis_code[0x6];
  40   1              dis_buf[6] = dis_code[0x7];
  41   1              dis_buf[7] = dis_code[0x8];
  42   1              
  43   1              dis_digit = 0x01;
  44   1              dis_index = 0;
  45   1              
  46   1              TR0 = 1;
  47   1              while(1);
  48   1      
  49   1      }
  50          
  51          void timer0() interrupt 1
  52          // 定时器0中断服务程序, 用于数码管的动态扫描
  53          // dis_index --- 显示索引, 用于标识当前显示的数码管和缓冲区的偏移量
  54          // dis_digit --- 位选通值, 传送到P2口用于选通当前数码管的数值, 如等于0x01时,
C51 COMPILER V9.00   MAIN                                                                  06/22/2016 14:55:51 PAGE 2   

  55          //                              选通P2.0口数码管
  56          // dis_buf   --- 显于缓冲区基地址       
  57          {
  58   1              TH0 = 0xFA;
  59   1              TL0 = 0x17;
  60   1              
  61   1              P2 = 0x00;                                                      // 先关闭所有数码管
  62   1              P0 = dis_buf[dis_index];                        // 显示代码传送到P0口
  63   1              P2 = dis_digit;                                         // 
  64   1      
  65   1              dis_digit = _crol_(dis_digit,1);        // 位选通值左移, 下次中断时选通下一位数码管
  66   1              dis_index++;                                            // 
  67   1                                              
  68   1              dis_index &= 0x07;                      // 8个数码管全部扫描完一遍之后，再回到第一个开始下一次扫描
  69   1      }


