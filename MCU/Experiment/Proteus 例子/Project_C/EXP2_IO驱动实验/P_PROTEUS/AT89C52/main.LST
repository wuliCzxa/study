  14          #define uchar unsigned char      //数据类型宏定义
  15          #define uint unsigned int
  16          /*********************引脚定义********************/
  17          #define LED   P0
  18          
  19          /*********************延时函数********************/
  20          void delayms(uchar ms)  
  21          // 延时子程序
  22          {                                               
  23   1              unsigned char i;
  24   1              while(ms--)
  25   1              {
  26   2                      for(i = 0; i < 120; i++);
  27   2              }
  28   1      }
  29          /*********************主函数**********************/
  30          void main(void)
  31          {
  32   1              LED = 0xfe;                                             //初始化P0口
  33   1              while(1)
  34   1              {                                                               //延时
  35   2                      delayms(250);                   
  36   2                      LED = _crol_(LED,1);            //循环右移1位，点亮下一个LED
  37   2              }
  38   1      }
