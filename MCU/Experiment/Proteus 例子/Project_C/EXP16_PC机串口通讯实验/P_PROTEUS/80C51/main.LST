   9          #include <reg52.h>
  10          #define uchar unsigned char
  11          #define uint unsigned int
  12          uchar a[]="www.windway.cn";
  13          uchar b[]="Welcome to you!";
  14          
  15          void UART_Init(void);
  16          void UART_SendData(uchar dat);
  17          void UART_SendString(uchar *p);
