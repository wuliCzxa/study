   7          -------------------------------------------------------------------------------- 
   8          * 功能描述:                                                                    
   9          *          程序每重新运行一次                                                  
  10          *          就向24C02的特定地址读出一字节数据，                                 
  11          *          然后把该字节数据显示出来，然后对该字节数据加一后，                  
  12          *          重新写入该地址
  13          *-------------------------------------------------------------------------------
  14          *接线说明：P10-SDA，P11-SCK，P00~P07——SA~SH，P20~P22——C0~C2                                                                
  15          *******************************************************************************/
  16          #include <reg52.h>
  17          #include <intrins.h>
  18          
  19          #define uchar unsigned char 
  20          #define uint unsigned int
  21          #define rom_add 0x0a      //定义特定地址读取
  22          #define P_COM P2                  //位控制输出接口
  23          #define P_SEG P0                  //段码控制输出接口
  24          
  25          /*******端口定义***************************************************************/
  26          sbit SCK=P1^1;
  27          sbit SDA=P1^0;
  28          
  29          unsigned char data dis_digit;
  30          unsigned char code dis_code[11]={0xc0,0xf9,0xa4,0xb0,   // 0, 1, 2, 3
  31                                                                           0x99,0x92,0x82,0xf8,0x80,0x90, 0xff};// 4, 5, 6, 7, 8, 9, off 
  32          unsigned char data dis_buf[3];    //定义显示位数 2位
  33          unsigned char data dis_cnt;
  34          
  35          uchar rom_dat=0; //写入数据初始化为0
  36          /********函数申明**************************************************************/
  37          void    start(void);            //开始信号
  38          void    stop(void);             //停止信号
  39          bit     rack(void);                     //接收应答信号
  40          void    ackn(void);             //发送无应答信号
  41          void    send_byte(uchar);       //发送一个字节
  42          uchar   rec_byte(void);         //接收一个字节
  43          void    write(void);            //写一组数据
  44          
  45          
  46          
  47          
  48          /********nms延时子程序*********************************************************/
  49          void Delay_Nms(uint n)
  50          {
  51   1              uint i,j;
  52   1              for(i=0;i<n;i++)
  53   1                      for(j=0;j<125;j++)
  54   1                              ;
  55   1      }
