  56          
  57          /********发送开始信号**********************************************************/
  58          void start(void)
  59          {
  60   1              SCK=1;
  61   1              SDA=1;
  62   1              _nop_();
  63   1              SDA=0;
  64   1              _nop_();
  65   1              SCK=0;
  66   1              _nop_();
  67   1      }
  68          
  69          /********发送停止信号*********************************************************/
  70          void stop(void)
  71          {
  72   1              SCK=0;
  73   1              SDA=0;
  74   1              _nop_();
  75   1              SCK=1;
  76   1              _nop_();
  77   1              SDA=1;
  78   1              _nop_();
  79   1      }
  80          
  81          /********接收一个应答位*******************************************************/
  82          bit rack(void)
  83          {
  84   1              bit flag;
  85   1              SCK=1;
  86   1              _nop_();
  87   1              flag=SDA;
  88   1              SCK=0;
  89   1              return(flag);
  90   1      }
  91          
  92          /********发送一个非接收接收应答位*********************************************/
  93          void ackn(void)
  94          {
  95   1              SDA=1;
  96   1              _nop_();
  97   1              SCK=1;
  98   1              _nop_();
  99   1              SCK=0;
 100   1              _nop_();
 101   1      }
 102          
 103          /********接收一个字节*********************************************************/
 104          uchar rec_byte(void)
 105          {
 106   1              uchar i,temp;
 107   1              for(i=0;i<8;i++)
 108   1              {
 109   2                      temp<<=1;
 110   2                      SCK=1;
 111   2                      _nop_();
 112   2                      temp|=SDA;
 113   2                      SCK=0;
 114   2                      _nop_();
 115   2              }
 116   1      return(temp);
 117   1      }
C51 COMPILER V9.00   MAIN                                                                  12/15/2015 14:07:46 PAGE 3   

 118          
 119          /********发送一个字节*********************************************************/
 120          void send_byte(uchar temp)
 121          {
 122   1              uchar i;
 123   1              SCK=0;
 124   1              for(i=0;i<8;i++)
 125   1              {
 126   2                      SDA=(bit)(temp&0x80);
 127   2                      SCK=1;
 128   2                      _nop_();
 129   2                      SCK=0;
 130   2                      temp<<=1;
 131   2              }
 132   1              SDA=1;
 133   1      }
 134          /********读函数**************************************************************/
 135          void read(void)
 136          {
 137   1              bit f;
 138   1              start();                        //开始信号
 139   1              send_byte(0xa0);        //发送读命令
 140   1              f=rack();                       //接收应答
 141   1              if(!f)
 142   1              {               
 143   2                      send_byte(rom_add);//设置要读取从器件的片内地址
 144   2                      f=rack();
 145   2                      if(!f)
 146   2                      {
 147   3                              start();                   //开始信号
 148   3                              send_byte(0xa1);        //发送读命令    
 149   3                              f=rack();
 150   3                              if(!f)
 151   3                              {
 152   4                                      rom_dat=rec_byte();//读出数据
 153   4                                      ackn();
 154   4                               }                      
 155   3                  }                                                   
 156   2              }
 157   1              stop();
 158   1      }
 159          /*******写函数***************************************************************/
 160          void write(void)
 161          {
 162   1              bit f;
 163   1              start();
 164   1              send_byte(0xa0);                         //发送读命令
 165   1              f=rack();
 166   1              if(!f)
 167   1              {
 168   2                      send_byte(rom_add);              //发送器件地址
 169   2                      f=rack();
 170   2                      if(!f)
 171   2                      {
 172   3                              send_byte(rom_dat);      //发送数据
 173   3                              f=rack();
 174   3                       }
 175   2              } 
 176   1              stop();
 177   1      }
 178          /********主函数***************************************************************/
 179          void main(void)
C51 COMPILER V9.00   MAIN                                                                  12/15/2015 14:07:46 PAGE 4   

 180          {
 181   1              P_COM = 0xff;  //点亮所有数码管
 182   1              P_SEG = 0x00;
 183   1              TMOD = 0x01;   //初始化定时器0
 184   1              TH0  = 0xFC;
 185   1              TL0  = 0x17;
 186   1              IE       = 0x82;   //开中断
 187   1              Delay_Nms(20);
 188   1              read();            //从EEPROM中读取数据
 189   1              dis_buf[0]=dis_code[rom_dat/100];       //数据暂存到数据缓冲器
 190   1              dis_buf[1]=dis_code[(rom_dat%100)/10];
 191   1              dis_buf[2]=dis_code[rom_dat%10];
 192   1              rom_dat+=1;        //计数器加1
 193   1              Delay_Nms(20);
 194   1              write();           //再次把数据写回到EEPROM中
 195   1              TR0 = 1;           //启动定时器定时
 196   1              while(1)
 197   1              {;}
 198   1      }
 199          /********定时器0中断处理函数**************************************************/
 200          void timer0() interrupt 1
 201          // 定时器0中断服务程序, 用于数码管的动态扫描
 202          // dis_cnt --- 扫描计数
 203          // dis_buf   --- 显于缓冲区基地址       
 204          {
 205   1              TH0 = 0xFA;
 206   1              TL0 = 0x17;
 207   1              P_COM = 0x00;                                                   // 先关闭所有数码管
 208   1      
 209   1              switch(dis_cnt)
 210   1              {
 211   2                      case    0:P_COM=0x01;P_SEG=dis_buf[0];dis_cnt++;break;
 212   2                      case    1:P_COM=0x02;P_SEG=dis_buf[1];dis_cnt++;break; 
 213   2                      case    2:P_COM=0x04;P_SEG=dis_buf[2];dis_cnt=0;break; //扫描最末位时 清零位扫描计数
 214   2                      default  :break;        
 215   2              }
 216   1      }
