   7          -------------------------------------------------------------------------------- 
   8          功能描述:                                                              
   9          *          控制74LS164                                                 
  10          *          循环送出从0到0XFF 256个8位数据                                         
  11          *          实现串行数据输入 并行数据输出 
  12          --------------------------------------------------------------------------------
  13          *接线说明：P10-/CLR，P11-CP,P12-SI,QA~QH——D1~D8 ，LED 循环熄灭                                   
  14          *******************************************************************************/
  15          #include <reg52.h>
  16          
  17          #define uchar unsigned char
  18          #define uint unsigned int
  19          
  20          void delayms(uint);
  21          /**********端口定义***********************************************************/
  22          sbit CLR = P1^0;
  23          sbit CP  = P1^1;
  24          sbit SI  = P1^2;
  25          
  26          
  27          /**********nms延时子程序******************************************************/
  28          void Delay_Nms(uint n)
  29          {
  30   1              uint i,j;
  31   1              for(i=0;i<n;i++)
  32   1                      for(j=0;j<125;j++)
  33   1                              ;
  34   1      }
  35          
  36          /**********发送一字节数据*****************************************************/
  37          void SendOneByte(uchar Bdat)
  38          {  
  39   1         uchar i; 
  40   1          
  41   1          for(i=0;i<8;i++) 
  42   1          { 
  43   2              SI=(bit)(Bdat & 0x80);          //判断输出数据 
  44   2              CP=0;                               //初始化移位时钟 
  45   2              Bdat<<=1;                                   //更新数据 
  46   2              CP=1; 
  47   2          }    
  48   1      }
  49          /**********主函数*************************************************************/
  50          void main(void) 
  51          { 
  52   1          uchar i; 
  53   1              CLR = 0;                 //清除164输出
  54   1              CLR = 1;                 //允许164输出
  55   1           while(1) 
C51 COMPILER V9.00   MAIN                                                                  06/27/2016 10:47:24 PAGE 2   

  56   1          {   
  57   2                       for(i=0;i<0xff;i++) 
  58   2              {               
  59   3                      SendOneByte(i); //译码显示  
  60   3                                      Delay_Nms(500); //延时
  61   3                  }   
  62   2          }                
  63   1      }


