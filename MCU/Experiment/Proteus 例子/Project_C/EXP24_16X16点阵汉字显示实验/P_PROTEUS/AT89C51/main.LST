  57          
  58          /**********nms延时子程序*************/
  59          void Delay_Nms(uint n)
  60          {
  61   1              uint i,j;
  62   1              for(i=0;i<n;i++)
  63   1                      for(j=0;j<20;j++)
  64   1                              ;
  65   1      }
  66          
  67          
  68          
  69          /**********发送一字节数据*************/
  70          void SendOneByte(uchar content)
  71          {  
  72   1         uchar i; 
  73   1          
  74   1          for(i=0;i<8;i++) 
  75   1          { 
  76   2              LS595_DS=(bit)(content & 0x80);      //判断输出数据 
  77   2              LS595_SHC=0;                                 //初始化移位时钟 
  78   2              content<<=1;                                             //更新数据 
  79   2              LS595_SHC=1; 
  80   2          }    
  81   1      }
  82          
  83          /***********主函数********************/
  84          void main(void) 
  85          { 
  86   1          uchar i;
  87   1              uchar j;
  88   1              uchar k;
  89   1              uchar   ycode; 
  90   1              LS138_EN1=0;             //不使能138译码器  
  91   1              LS138_EN2=0;             //不使能138译码器  
  92   1              while(1) 
  93   1          {   for(j=0;j<4;j++)
  94   2                      {
  95   3                              for(k=0;k<50;k++)
  96   3                              {
  97   4                                      for(i=0;i<16;i++) 
  98   4                              { 
  99   5                                              LS595_STC=0;                                            
 100   5                              SendOneByte(dischar[i*2+j*32+1]); //译码显示 
 101   5                                              SendOneByte(dischar[i*2+j*32]);   //译码显示                    
 102   5                                              LS595_STC=1;          //数据已准备好
 103   5                                              if(i<8)
 104   5                                              {
 105   6                                                      //ycode=i;
 106   6                                                      P2=i;                 //开启扫描的行数据 
 107   6                                                      LS138_EN1=1;      //打开前8行输出
 108   6                                                      //LS138_EN2=0;    //关闭后8行输出
 109   6                                              }        
 110   5                                              else 
 111   5                                              {
 112   6                                                      ycode=i-8;
 113   6                                                      P2=ycode<<4;      //开启扫描的行数据 
 114   6                                                      //LS138_EN1=0;    //关闭前8行输出
 115   6                                                      LS138_EN2=1;      //打开后8行输出
 116   6                                              }                
 117   5                              Delay_Nms(4);
C51 COMPILER V9.00   MAIN                                                                  10/26/2015 15:30:51 PAGE 3   

 118   5                                              LS138_EN1=0;          //关闭行输出
 119   5                                              LS138_EN2=0;          //关闭行输出                  
 120   5                      }
 121   4                              } 
 122   3                      }
