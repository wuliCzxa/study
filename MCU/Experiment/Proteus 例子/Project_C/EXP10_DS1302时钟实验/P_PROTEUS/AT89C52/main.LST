  15          //#include "absacc.h"
  16          #include <intrins.h>
  17          #define uchar unsigned char
  18          #define uint unsigned int
  19          #define out P0
  20          /////////////////////////////////////
  21          //#define LCD_WC XBYTE[0X7FFC]
