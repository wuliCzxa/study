   7          -------------------------------------------------------------------------   
   8          *功能描述: 通过RS485端口不停地发送数据a——z
   9          *                  用示波器观察RS485端口A、B信号线上的波形
  10                     或者用RS485接收器接收发送的字符。
  11          -------------------------------------------------------------------------
  12          * 接线说明：P30-RO,P31-DI,P32-DIR,CA或CB接示波器
  13          *                                                           
  14          *************************************************************************/
  15          #include <reg52.h>
  16          #include <string.h>
  17          
  18          #define uchar unsigned char
  19          #define uint unsigned int
  20          char code SST516[3] _at_ 0x003b;
  21          
  22          #define Seg  P1
  23          sbit A485_DIR1 = P3^2;          // 驱动器使能，1发送 
  24          sbit B485_DIR2 = P3^3;          // 驱动器使能，0接收
  25          sbit Com1 = P2^0;
  26          
  27          unsigned char code segbit[]={0xc0,0xf9,0xa4,0xb0,       // 0, 1, 2, 3
  28                                                                           0x99,0x92,0x82,0xf8,0x80,0x90, 0xff};// 4, 5, 6, 7, 8, 9, off
  29          
  30          uchar RecData(void);
  31          void SendByte(uchar Sdata);     // 该函数发送一帧数据中的一个字节，由send_data()函数调用
  32          void delayms(uint);
  33          
  34          void main()
  35          {
  36   1              uchar   i;
  37   1              A485_DIR1 = 1;     //   驱动器使能，1发送
  38   1          B485_DIR2 = 0;      // 驱动器使能，0接收
  39   1              Com1 = 1;
  40   1      /* 系统初始化 */
  41   1              SCON=0x50;
  42   1          TMOD=0x20;
  43   1              PCON=0x00;
  44   1          TH1 =0xfd;
  45   1              TL1 =0xfd;  //预置初值，设波特率为9600
  46   1              TR1 =1; 
  47   1              ES  =1;
  48   1              EA  =1;         //开中断
  49   1      
  50   1      
  51   1      /* 主程序流程 */
  52   1              while(1)    // 主循环
  53   1              {
  54   2                      for(i=0;i<10;i++)
  55   2                      {
C51 COMPILER V9.00   MAIN                                                                  10/28/2015 16:57:54 PAGE 2   

  56   3                              SendByte(segbit[i]);                    
  57   3                              delayms(1000);
  58   3                      }
  59   2                      //Seg = segbit[1];                         
  60   2              } 
  61   1      }
  62          
  63          
  64          
  65          /********************************************************* 
  66          **函数名称：INT_UART_Rev()
  67          **函数功能：串口接收中断函数 
  68          *********************************************************/
  69          void INT_UART_Rev() interrupt 4
  70          {
  71   1              if(RI)
  72   1              { 
  73   2                      RI=0;
  74   2                      Seg = SBUF;
  75   2              }
  76   1      }
  77          
  78          /* 该函数发送一个数据字节，若该字节为0xdb，则发送0xdbdd，若该字节为0xc0则，发送0xdbdc */
  79          void SendByte(uchar Sdata)
  80          {
  81   1          //M_DIR = 1;    // 置发送允许，接收禁止
  82   1              SBUF = Sdata;
  83   1          while(!TI);
  84   1          TI = 0;
  85   1      }
  86          
  87          void delayms(uint j)
  88          {
  89   1              uchar i;
  90   1              for(;j>0;j--)
  91   1      {
  92   2               i=250;
  93   2               while(--i);
  94   2               i=249;
  95   2               while(--i);
  96   2              }
  97   1      }


