   5          说 明：    DS18B20温度传感器实验 
   6          修改记录：  
   7          ------------------------------------------------------------
   8          *功能描述: 实时测量周边环境的温度，并提供数码管显示温度值                                                 
             -                                                                            
   9          *-----------------------------------------------------------                                                                            
             -               
  10          *接线说明：P00~P07-SA~SH，P10~P11-C0~C1,P37-DQ                                                                                        
             - 
  11          *                                                                                                         
             -                                                   
  12          ************************************************************/
  13          #include <reg52.h>
  14          #include <intrins.h>
  15          #define uchar unsigned char
  16          #define uint unsigned int 
  17          
  18          uchar code seg[]={0xc0,0xf9,0xa4,0xb0,0x99,0x92,0x82,0xf8,0x80,0x90,0x01};
  19          
  20          
  21          sbit DQ=P3^7;   //定义io口
  22          void delay5(uchar);
  23          void init_ds18b20(void);
  24          uchar readbyte(void);
  25          void writebyte(uchar);
  26          uchar retemp(void);
  27          /*********主函数********************************************/
  28          void main(void)
  29          {
  30   1      uchar i,temp;
  31   1      delay5(1000);
  32   1      temp=retemp(); //读取温度值
  33   1      while(1)
  34   1              {
  35   2                               
  36   2                      for(i=0;i<50;i++)
  37   2                      {
  38   3                      P0 = seg[temp/10];      // 输出十位
  39   3                      P1 = 0x01;
  40   3                      delay5(1000);           //延时5ms
  41   3                      if(i==0)                        //扫描50次 采样一次
  42   3                      temp=retemp();
  43   3              P0=0xff;
  44   3      
  45   3                      P0 = seg[temp%10];      // 输出个位
  46   3                      P1 = 0x02;       
  47   3                      delay5(1000);           //延时5ms
  48   3      
  49   3              P0=0xff;
  50   3                      }
C51 COMPILER V9.00   MAIN                                                                  03/09/2017 14:56:04 PAGE 2   

  51   2                                
  52   2              }
  53   1      
  54   1      }
  55          
  56           /*--------------精确延时5us子程序---------*/   
  57          void delay5(uchar n)
  58          {
  59   1               do
  60   1               {
  61   2               _nop_();
  62   2               _nop_();
  63   2               _nop_();
  64   2               n--;
  65   2               }
  66   1               while(n);
  67   1      }
  68          /*--------------初始化函数--------------------*/
  69          void init_ds18b20(void)
  70          {
  71   1               uchar x=0; 
  72   1               DQ =0;    
  73   1               delay5(100); 
  74   1               DQ =1;    
  75   1               delay5(5);
  76   1               delay5(20);
  77   1      }
  78          /*--------------读取一字节函数----------------*/
  79          uchar readbyte(void)
  80          {
  81   1              uchar i=0;
  82   1              uchar date=0;
  83   1              for (i=8;i>0;i--)
  84   1               {
  85   2                        DQ =0;
  86   2                        delay5(1);
  87   2                        DQ =1;        //15微秒内拉释放总线
  88   2                        date>>=1;
  89   2                        if(DQ)
  90   2                        date|=0x80;
  91   2                        delay5(11);
  92   2               }
  93   1              return(date);
  94   1      }
  95          /*--------------写一字节函数------------------*/
  96          void writebyte(uchar dat)
  97          {
  98   1       uchar i=0;
  99   1       for(i=8;i>0;i--)
 100   1               {
 101   2                DQ =0;
 102   2                DQ =dat&0x01;    //写"1" 在15微秒内拉低
 103   2                delay5(12);      //写"0" 拉低60微秒
 104   2                DQ = 1;          
 105   2                dat>>=1;
 106   2                delay5(5);
 107   2                }
 108   1      }
 109          /*--------------读取温度函数------------------*/
 110          uchar retemp(void)
 111          {
 112   1              uchar a,b,tt;
C51 COMPILER V9.00   MAIN                                                                  03/09/2017 14:56:04 PAGE 3   

 113   1              uint t;
 114   1              init_ds18b20();         //初始化
 115   1              writebyte(0xCC);        //写命令
 116   1              writebyte(0x44);
 117   1              init_ds18b20();
 118   1              writebyte(0xCC); 
 119   1              writebyte(0xBE); 
 120   1              a=readbyte();           //读出低位
 121   1              b=readbyte();           //读出高位
 122   1              t=b;
 123   1              t<<=8;
 124   1              t=t|a;
 125   1              tt=t*0.0625;            //转换为摄氏温度值
 126   1              return(tt);
 127   1      }
