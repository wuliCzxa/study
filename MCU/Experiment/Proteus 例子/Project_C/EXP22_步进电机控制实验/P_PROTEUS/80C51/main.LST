  13          #include <reg52.h>
  14          #define uchar unsigned char
  15          #define uint unsigned int
  16          #define out  P2
  17          /***********端口定义******************************/
  18          sbit pos=P0^0;
  19          sbit neg=P0^1;
  20          void delayms(uint);
  21          uchar code turn[]={0x02,0x06,0x04,0x0c,0x08,0x09,0x01,0x03};
  22          
  23          /***********主函数********************************/
  24          void main(void)
  25          {
  26   1              uchar i;
  27   1              out=0x03;
  28   1              while(1)
  29   1              {
  30   2                      if(!pos)                        //正转
  31   2                      {
  32   3                              i = i < 8 ? i+1 : 0;
  33   3                              out=turn[i];
  34   3                              delayms(50);
  35   3                      }
  36   2                      else if(!neg)           //反转
  37   2                      {
  38   3                              i = i > 0 ? i-1 : 7;    
  39   3                              out=turn[i];
  40   3                              delayms(50);
  41   3                      }       
  42   2              }
  43   1      }
  44          /***********延时函数******************************/
  45          void delayms(uint j)
  46          {
  47   1              uchar i;
  48   1              for(;j>0;j--)
  49   1              {
  50   2                      i=250;
  51   2                      while(--i);
  52   2                      i=249;
  53   2                      while(--i);
  54   2              }
  55   1      }
