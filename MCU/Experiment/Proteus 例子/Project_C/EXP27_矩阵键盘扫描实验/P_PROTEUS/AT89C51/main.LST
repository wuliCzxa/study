   8          /*******************************************************************************    
   9          * 功能描述:                                                              *
  10          *          扫描矩阵键盘                                                  *
  11          *          当有键按下时按照按键的位置                                    *
  12          *          显示当前的键值
  13          
  14          *接线说明：P00~P07-SA~SG，P10~P13-R1~R4，P14~P17-C1~C4，P20-C0                                            
             -   
  15          *******************************************************************************/
  16          #include <reg52.h>
  17          #include<intrins.h>
  18          
  19          #define uchar unsigned char
  20          #define uint unsigned int
  21          
  22          #define PSEG P0
  23          #define PKEY P1 
  24          
  25          sbit C0  = P2^0;//位定义
  26          
  27          void delayms(uint);
  28          uchar scan(void);
  29          
  30          uchar code seg[]={0xc0,0xf9,0xa4,0xb0,0x99,0x92,0x82,0xf8,0x80,0x90,0x88,0x83,0xc6,0xa1,0x86,0x8e};
  31          /**********主函数******************************************/
  32          void main(void)
  33          {
  34   1              uchar key;
  35   1              C0=1;
  36   1              while(1)
  37   1              {
  38   2                      key=scan();     //读取键盘值
  39   2                      if(key!=16)
  40   2                      PSEG=seg[key];  //显示
  41   2              }
  42   1      }
  43          /***********延时函数***************************************/
  44          void delayms(uint j)
  45          {
  46   1      uchar i;
  47   1      for(;j>0;j--)
  48   1              {
  49   2               i=250;
  50   2               while(--i);
  51   2               i=249;
  52   2               while(--i);
  53   2              }
  54   1      }
C51 COMPILER V9.00   MAIN                                                                  10/26/2015 16:09:47 PAGE 2   

  55          /***********键盘扫描函数***********************************/
  56          uchar scan(void)
  57          {
  58   1      uchar k=16,m,n,in;
  59   1      PKEY=0xf0;              //扫描所有行
  60   1      if((PKEY&0xf0)!=0xf0)
  61   1              {
  62   2              for(m=0;m<4;m++)
  63   2                      {
  64   3                      PKEY=~(0x01<<m);
  65   3                      for(n=0;n<4;n++)
  66   3                              {
  67   4                              in=PKEY;
  68   4                              in=in>>(4+n);
  69   4                              if((in&0x01)==0)
  70   4                                      {
  71   5                                      delayms(10);
  72   5                                      if((in&0x01)==0){k=n+m*4;break;}
  73   5                                      }
  74   4                              }
  75   3                      if(k!=16){break;}
  76   3                      }
  77   2              }
  78   1      return(k);
  79   1      }


