   1          #include <reg51.h>
   2          #include <stdio.h>
   3          #define uchar unsigned char
   4          #define uint unsigned int
   5          
   6          #define led_out P2      //定时P2 名为 LED输出
   7          
   8          sbit button=P1^0;
   9          ///////////////延时函数/////////////////////////
  10          void delay1ms(uint j)             //1ms延时
  11          {
  12   1      uchar i;
  13   1      for(;j>0;j--)
  14   1              {
  15   2               i=250;
  16   2               while(--i);
  17   2               i=249;
  18   2               while(--i);
  19   2              }
  20   1      }
  21          ////////主函数////////////////////
  22          void main(void)
  23           { 
  24   1         uchar i=0;
  25   1      //   led_out=0x01;      //寄存器操作
  26   1         while (1)
  27   1         {
  28   2              if(button==1)
  29   2              {
  30   3                  led_out=~(0x01<<i);
  31   3                  i++;
  32   3                  i&=0x07;
  33   3                  delay1ms(500); 
  34   3              }
  35   2              else
  36   2              {
  37   3                 led_out=0xaa;
  38   3                 delay1ms(500);
  39   3                 led_out=0x55;
  40   3                 delay1ms(500);
  41   3              }
  42   2          }
  43   1       }
