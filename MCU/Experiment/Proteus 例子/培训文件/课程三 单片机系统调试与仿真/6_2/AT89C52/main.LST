  61   1         while (1)
  62   1         {;
  63   2          }
  64   1       }
  65            /////////////外部中断函数0///////////////////////////
  66           void Outside_Int0(void) interrupt 2
  67           {
  68   1      
  69   1         for(a=0;a<8;a++)
  70   1         {
  71   2            led_out=~(0x01<<a);
  72   2            delay1ms(1000); 
  73   2            }
  74   1          
  75   1        }
  76            /////////////定时器中断函数0///////////////////////////
  77          void Time0_Int() interrupt 1
  78           {
  79   1          TH0  = 0xE0;
  80   1          TL0  = 0x18;
  81   1          count++;
  82   1          if(count==1000)
  83   1          {
  84   2             count=0;
  85   2             led_out=0x01<<b;
  86   2             b++;
  87   2             if(b>7)b=0;
  88   2            
  89   2          }
  90   1        }
