  11          ///////////////延时函数/////////////////////////
  12          void delay1ms(uint j)             //1ms延时
  13          {
  14   1      uchar i;
  15   1      for(   ;j>0;j--)
  16   1              {
  17   2               i=250;
  18   2               while(--i);
  19   2               i=249;
  20   2               while(--i);
  21   2              }
  22   1      }
  23          /********************************************************************
  24          * 名称 : Outside_Init0()
