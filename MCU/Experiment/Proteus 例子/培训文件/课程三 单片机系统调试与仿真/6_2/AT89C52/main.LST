  41          * 输入 : 无
  42          * 输出 : 无
  43          ***********************************************************************/
  44          void Time0_Init()
  45          {
  46   1              TMOD = 0x00;    //方式0，13位定时功能      
  47   1      //      TMOD = 0x04;    //方式0，13位计数功能
  48   1              TH0  = 0xE0;    //高八低5位
  49   1              TL0  = 0x18;
  50   1           
  51   1              ET0 = 1;
  52   1              EA = 1;         
  53   1              TR0 = 1;                
  54   1      }
