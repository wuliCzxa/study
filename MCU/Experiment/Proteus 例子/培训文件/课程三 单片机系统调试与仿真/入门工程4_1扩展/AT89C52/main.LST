  13          /********************************************************************
  14          * 名称 : Time0_Init()
  15          * 功能 : 定时器的初始化，1ms  12M晶振 即初值加1只要1us。
  16          * 输入 : 无
  17          * 输出 : 无
  18          ***********************************************************************/
  19          void Time0_Init()
  20          {
  21   1              TMOD = 0x01;    //方式1，16位定时功能
  22   1              TH0  = 0x3c;    //初值  50ms定时
  23   1              TL0  = 0xb0;
