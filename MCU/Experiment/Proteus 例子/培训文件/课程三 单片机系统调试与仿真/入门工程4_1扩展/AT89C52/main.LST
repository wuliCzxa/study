  28          ///////////////延时函数/////////////////////////
  29          void delayms(uint j)              //1ms延时
  30          {
  31   1         uchar i;
  32   1         for(;j>0;j--)
  33   1        {
  34   2            i=250;
  35   2            while(--i);
  36   2            i=249;
  37   2            while(--i);
  38   2         }
  39   1      }
  40          //////////////主函数//////////////////////////
  41          void main(void)
