  29          /////////////发送一个字符数据//////////////////////////
  30          void Com_SendBye(uchar dat)
  31          {
  32   1            SBUF=dat;
  33   1            while(!TI);       //如果发送完毕，硬件会置位TI
  34   1            TI=0;             //TI清零
  35   1      }
  36          /////////////发送字符串//////////////////////////
  37           void Com_SendStr(uchar *dat)
  38           {      
  39   1          while(1)
  40   1          {
  41   2            if(*dat == '\0')  //在每个字符串的最后，会有一个'\0'
  42   2              break;
  43   2            else 
  44   2            {
  45   3               SBUF=*dat;
  46   3               while(!TI);       //如果发送完毕，硬件会置位TI
  47   3               TI = 0;                //TI清零
  48   3               dat++;
  49   3            }
  50   2         }
  51   1       }
