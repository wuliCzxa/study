 Line  I  Addr  Code            Source

   42:
   43:	  002B			DISPLAY_INIT:
   44:	  002B	75 38 00	    MOV DIG_INDEX, #0 ; 从第0位开始显示
   45:	  002E	22		    RET
   46:
   47:				; ----------- 中断服务程序（按键计数） -----------
   48:	  002F			INT0_ISR:
   49:	  002F	C0 E0		    PUSH ACC          ; 保护现场
   50:	  0031	C0 D0		    PUSH PSW
   51:				    ; 计数器加1（16位）
   52:	  0033	E5 30		    MOV A, COUNT
   53:	  0035	24 01		    ADD A, #1
   54:	  0037	F5 30		    MOV COUNT, A
   55:	  0039	E5 31		    MOV A, COUNT+1
   56:	  003B	34 00		    ADDC A, #0
   57:	  003D	F5 31		    MOV COUNT+1, A
   58:				    ; 转换为6位BCD码
   59:	  003F	12 00 47	    LCALL COUNT_TO_BCD
   60:	  0042	D0 D0		    POP PSW           ; 恢复现场
   61:	  0044	D0 E0		    POP ACC
   62:	  0046	32		    RETI
   63:
   64:				; ----------- 计数器转BCD码 -----------
   65:	  0047			COUNT_TO_BCD:
   66:	  0047	78 32		    MOV R0, #DIGITS   ; R0指向BCD数组
   67:	  0049	79 06		    MOV R1, #6        ; 6位数字
   68:	  004B	7A 00		    MOV R2, #0        ; 清零临时变量
   69:				    ; 此处省略具体转换代码（可用除法或查表法）
   70:	  004D	22		    RET
   71:
   72:				; ----------- 动态显示更新 -----------
   73:	  004E			UPDATE_DISPLAY:
   74:				    ; 1. 关闭当前位选（消隐）
   75:	  004E	74 07		    MOV A, #07H       ; 74HC138输入111（不选任何位）
   76:	  0050	F5 A0		    MOV BIT_PORT, A
   77:				    ; 2. 输出段码
   78:	  0052	E5 38		    MOV A, DIG_INDEX  ; 获取当前位索引
   79:	  0054	24 06		    ADD A, #SEG_TABLE ; 计算段码地址
   80:	  0056	93		    MOVC A, @A+DPTR   ; 读取段码
   81:	  0057	F5 80		    MOV SEG_PORT, A   ; 输出到74HC573
   82:				    ; 3. 打开当前位选
   83:	  0059	E5 38		    MOV A, DIG_INDEX  ; 位索引（0-5）
   84:	  005B	F5 A0		    MOV BIT_PORT, A    ; 74HC138选择对应位
   85:				    ; 4. 更新位索引
   86:	  005D	05 38		    INC DIG_INDEX
   87:	  005F	E5 38		    MOV A, DIG_INDEX
   88:	  0061	B4 06 03	    CJNE A, #6, SKIP_RESET
   89:	  0064	75 38 00	    MOV DIG_INDEX, #0  ; 超过5则归零
   90:	  0067			SKIP_RESET:
   91:				    ; 5. 延时1ms
   92:	  0067	12 00 6B	    LCALL DELAY_1MS
   93:	  006A	22		    RET
   94:
   95:				; ----------- 延时1ms -----------
   96:	  006B			DELAY_1MS:
   97:	  006B	7E 0A		    MOV R6, #10

