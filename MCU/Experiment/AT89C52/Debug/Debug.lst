 Line  I  Addr  Code            Source

    1:				; ----------- 头文件与寄存器定义 -----------
    2:		N      0000	ORG 0000H            ; 程序起始地址
    3:	  0000	02 00 10	LJMP MAIN            ; 跳转到主程序
    4:		N      0003	ORG 0003H            ; 外部中断0向量地址
    5:	  0003	02 00 2F	LJMP INT0_ISR        ; 中断服务程序
    6:
    7:				; ----------- 常量定义 -----------
    8:		D      0080	SEG_PORT EQU P0      ; 段选数据口（接74HC573）
    9:		D      00A0	BIT_PORT EQU P2      ; 位选控制口（接74HC138，P2.0-P2.2）
   10:
   11:				; 共阳数码管段码表（0-9）
   12:	  0006			SEG_TABLE:
   13:	  0006	C0 F9 A4 B0	    DB 0C0H, 0F9H, 0A4H, 0B0H, 99H, 92H, 82H, 0F8H, 80H, 90H
	  000A	99 92 82 F8
	  000E	80 90
   14:
   15:				; ----------- 变量定义 -----------
   16:		N	 30	DSEG AT 30H
   17:	    30	N	 02	COUNT:     DS 2      ; 16位计数器（0-999999）
   18:	    32	N	 06	DIGITS:    DS 6      ; 存储6位BCD码
   19:	    38	N	 01	DIG_INDEX: DS 1      ; 当前显示位索引（0-5）
   20:
   21:				; ----------- 主程序 -----------
   22:				CSEG
   23:	  0010			MAIN:
   24:	  0010	75 81 5F	    MOV SP, #5FH      ; 初始化栈指针
   25:	  0013	12 00 1E	    LCALL INIT        ; 初始化硬件
   26:	  0016	12 00 2B	    LCALL DISPLAY_INIT ; 初始化显示
   27:
   28:	  0019			LOOP:
   29:	  0019	12 00 4E	    LCALL UPDATE_DISPLAY ; 更新数码管显示
   30:	  001C	80 FB		    SJMP LOOP          ; 主循环
   31:
   32:				; ----------- 初始化函数 -----------
   33:	  001E			INIT:
   34:				    ; 配置外部中断0（下降沿触发）
   35:	  001E	D2 88		    SETB IT0          ; 边沿触发模式
   36:	  0020	D2 A8		    SETB EX0          ; 允许INT0中断
   37:	  0022	D2 AF		    SETB EA           ; 开总中断
   38:				    ; 初始化计数器
   39:	  0024	75 30 00	    MOV COUNT, #0
   40:	  0027	75 31 00	    MOV COUNT+1, #0
   41:	  002A	22		    RET

